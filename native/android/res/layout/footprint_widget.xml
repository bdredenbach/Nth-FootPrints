<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_brand" android:textColor="#C3A06A" android:textSize="11sp" android:letterSpacing="0.12" android:paddingBottom="8dp" />
    <ImageView android:id="@+id/widget_photo" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="centerCrop" android:background="#21362C" android:src="@drawable/widget_placeholder"
        android:contentDescription="@string/widget_open" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_empty" android:textSize="18sp" android:fontFamily="serif" android:textColor="#F5F2E9"
        android:maxLines="1" android:ellipsize="end" android:paddingTop="8dp" />
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_description" android:textSize="11sp" android:textColor="#C3CCBF" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_count_initial" android:textSize="11sp" android:textColor="#C3CCBF" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_add" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center"
            android:text="@string/widget_add" android:textColor="#F5F2E9" android:textSize="12sp" android:paddingLeft="12dp" android:paddingRight="12dp"
            android:background="@drawable/widget_button" android:contentDescription="@string/widget_add" />
    </LinearLayout>
</LinearLayout>
